---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-slate-light">
              项目作品
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.projects.map((project, index) => {
                const hasLink = !!project.link;
                const hasGithub = !!project.github;
                const hasEntry = hasLink || hasGithub;

                return (
                  <div
                    class={`group relative bg-navy-light rounded-xl sm:rounded-2xl border border-navy-lightest p-4 sm:p-6 md:p-8 transition-all duration-300 ${hasEntry ? "hover:bg-navy-lightest/60 hover:shadow-xl hover:border-slate-dark" : ""}`}
                  >
                    {hasEntry && (
                      <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 flex items-center gap-2">
                        {hasGithub && (
                          <a
                            href={project.github}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${project.name} 的 GitHub 源码`}
                            title="GitHub 源码"
                            class="w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center border rounded-full transition-all duration-300 hover:bg-[var(--entry-accent)]/10"
                            style={`color: ${siteConfig.accentColor}; border-color: ${siteConfig.accentColor}55; --entry-accent: ${siteConfig.accentColor}`}
                          >
                            <svg
                              class="w-4 h-4 sm:w-5 sm:h-5 md:w-5 md:h-5"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              viewBox="0 0 24 24"
                            >
                              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" />
                            </svg>
                          </a>
                        )}
                        {hasLink && (
                          <a
                            href={project.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`直接使用 ${project.name}`}
                            title="直接使用"
                            class="w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center rounded-full transition-all duration-300 hover:brightness-75"
                            style={`background-color: ${siteConfig.accentColor}; color: #0a192f`}
                          >
                            <svg
                              class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M7 17L17 7M17 7H7M17 7V17"
                              />
                            </svg>
                          </a>
                        )}
                      </div>
                    )}

                    <div class="space-y-4">
                      <div>
                        <span
                          class="text-sm font-mono"
                          style={{ color: siteConfig.accentColor }}
                        >
                          0{index + 1}
                        </span>
                        <h3 class="text-xl sm:text-2xl font-bold text-slate-light mt-1">
                          {project.name}
                        </h3>
                      </div>

                      <p
                        class={`text-base sm:text-lg text-slate leading-relaxed ${hasEntry ? "pr-24 sm:pr-28 md:pr-32" : ""}`}
                      >
                        {project.description}
                      </p>

                      {project.skills && project.skills.length > 0 && (
                        <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                          {project.skills.map((skill) => (
                            <span
                              class={`px-2.5 sm:px-3 py-1 sm:py-1.5 border rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-colors duration-300 ${hasEntry ? "group-hover:bg-[var(--skill-accent)]/10" : ""}`}
                              style={`color: ${siteConfig.accentColor}; border-color: ${siteConfig.accentColor}55; --skill-accent: ${siteConfig.accentColor}`}
                            >
                              {skill}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
