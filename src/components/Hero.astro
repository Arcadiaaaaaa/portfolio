---
import { siteConfig } from "../config";
---

<section class="hero">
  <h1 class="display">{siteConfig.tagline}</h1>
  <p class="lede">{siteConfig.aboutMe}</p>
  <a class="vp-btn vp-btn-primary" href={`mailto:${siteConfig.social.email}`}
    >联系我</a
  >
</section>

<style>
  .hero {
    padding: var(--space-4) 0;
  }
  .hero .display {
    margin: 0;
    max-width: 14em;
  }
  .hero .lede {
    margin: var(--space-2) 0 var(--space-3);
    color: var(--ink-muted);
    max-width: 40em;
  }
</style>
